<script>
(() => {
  /* =========================
     Storage + model
     ========================= */
  const LS_KEY = "writer_articles_v1";
  const LS_PROFILE = "writer_profile_v1";
  const uid = () => Math.random().toString(16).slice(2) + Date.now().toString(16);

  const defaultDateStr = () => formatJournalDate(new Date());

  function loadAll(){
    try { return JSON.parse(localStorage.getItem(LS_KEY) || "[]"); }
    catch { return []; }
  }
  function saveAll(list){
    localStorage.setItem(LS_KEY, JSON.stringify(list));
  }

  function loadProfile(){
    try { return JSON.parse(localStorage.getItem(LS_PROFILE) || "null"); }
    catch { return null; }
  }
  function saveProfile(p){
    localStorage.setItem(LS_PROFILE, JSON.stringify(p));
  }

  function newArticle(){
    const now = new Date();
    return {
      id: uid(),
      style: "modern",
      titleFont: "NYEgyptienne",
      titleSize: 48,
      bodyFont: "MillerText",
      dropcap: "off",

      kicker: "",
      title: "",
      byline: "",
      date: formatJournalDate(now),

      avatarDataUrl: null,

      blocks: [
        { id: uid(), type:"p", html:"", font:null, align:"left" },
      ],

      related: [
        // up to 3 slots, first suggested always present (empty until set)
        { title:"", url:"" },
      ],

      published: false,
      publishedAt: null,
      updatedAt: null,
      updateCount: 0,

      createdAt: now.toISOString(),
      savedAt: now.toISOString(),
    };
  }

  /* =========================
     Date formatting (journalistic abbreviations)
     ========================= */
  const MONTHS = ["Jan.","Feb.","Mar.","Apr.","May","Jun.","Jul.","Aug.","Sep.","Oct.","Nov.","Dec."];
  function formatJournalDate(d){
    const m = MONTHS[d.getMonth()];
    const day = d.getDate();
    const y = d.getFullYear();
    return `${m} ${day}, ${y}`;
  }

  /* =========================
     Smart punctuation
     -- => em dash
     primes => curly quotes
     ========================= */
  function smartenPlain(text){
    // em dash
    text = text.replace(/--/g, "—");

    // curly apostrophes
    // turn straight quotes into curly quotes (simple heuristic)
    // apostrophes inside words
    text = text.replace(/(\w)'(\w)/g, "$1’$2");
    // leading apostrophes
    text = text.replace(/(^|\s)'/g, "$1‘");
    // remaining apostrophes
    text = text.replace(/'/g, "’");

    // double quotes
    // opening quotes after whitespace/start
    text = text.replace(/(^|\s)"/g, "$1“");
    // remaining
    text = text.replace(/"/g, "”");

    return text;
  }

  /* =========================
     Paste sanitization:
     keep only: b/strong, i/em, u, a[href]
     strip all styles/classes/fonts
     ========================= */
  function sanitizeClipboardHTML(html){
    const doc = new DOMParser().parseFromString(html, "text/html");
    const allowed = new Set(["B","STRONG","I","EM","U","A","BR","P","DIV","SPAN"]);
    const walker = doc.createTreeWalker(doc.body, NodeFilter.SHOW_ELEMENT, null);

    const toRemove = [];
    while(walker.nextNode()){
      const el = walker.currentNode;
      if(!allowed.has(el.tagName)){
        // unwrap: replace with its text content
        const text = doc.createTextNode(el.textContent || "");
        el.parentNode && el.parentNode.replaceChild(text, el);
        continue;
      }
      // remove attributes except href on A
      [...el.attributes].forEach(a => {
        if(el.tagName === "A" && a.name.toLowerCase()==="href") return;
        el.removeAttribute(a.name);
      });
      if(el.tagName === "A"){
        // force safe-ish
        const href = el.getAttribute("href") || "";
        if(!href) el.removeAttribute("href");
        el.setAttribute("rel","noopener noreferrer");
        el.setAttribute("target","_blank");
      }
    }

    // Convert block wrappers into simple inline flow with <br><br> for paragraphs.
    // We'll keep <br> and strip empty wrappers.
    let out = doc.body.innerHTML;

    // normalize div/p to line breaks
    out = out.replace(/<\/(p|div)>\s*<(p|div)[^>]*>/gi, "<br><br>");
    out = out.replace(/<\/?(p|div|span)[^>]*>/gi, "");

    // trim
    out = out.trim();
    return out;
  }

  function insertHTMLAtCursor(html){
    const sel = window.getSelection();
    if(!sel || sel.rangeCount===0) return;
    const range = sel.getRangeAt(0);
    range.deleteContents();
    const temp = document.createElement("div");
    temp.innerHTML = html;
    const frag = document.createDocumentFragment();
    let node;
    let lastNode = null;
    while((node = temp.firstChild)){
      lastNode = frag.appendChild(node);
    }
    range.insertNode(frag);
    if(lastNode){
      range.setStartAfter(lastNode);
      range.collapse(true);
      sel.removeAllRanges();
      sel.addRange(range);
    }
  }

  /* =========================
     Router
     ========================= */
  const viewLanding = byId("viewLanding");
  const viewArticles = byId("viewArticles");
  const viewEditor = byId("viewEditor");

  function show(view){
    [viewLanding, viewArticles, viewEditor].forEach(v => v.classList.remove("active"));
    view.classList.add("active");
  }

  /* =========================
     DOM refs
     ========================= */
  function byId(id){ return document.getElementById(id); }

  const goHome = byId("goHome");
  const accountBtn = byId("accountBtn");
  const newArticleBtn = byId("newArticleBtn");
  const startWriting = byId("startWriting");

  const cards = byId("cards");
  const searchInput = byId("searchInput");
  const createFromList = byId("createFromList");
  const exportAllBtn = byId("exportAll");
  const importAllBtn = byId("importAll");
  const importFile = byId("importFile");

  const stage = byId("stage");
  const stageIn = byId("stageIn");

  const kicker = byId("kicker");
  const kickerPlus = byId("kickerPlus");
  const title = byId("title");
  const byline = byId("byline");
  const dateEl = byId("date");

  const avatarBtn = byId("avatarBtn");
  const avatarImg = byId("avatarImg");
  const avatarFile = byId("avatarFile");

  const blocksEl = byId("blocks");
  const relatedSlot = byId("relatedSlot");
  const lastUpdatedMount = byId("lastUpdatedMount");

  const modeEdit = byId("modeEdit");
  const modePreview = byId("modePreview");
  const saveBtn = byId("saveBtn");
  const publishBtn = byId("publishBtn");

  const lockedPanel = byId("lockedPanel");

  const appr = byId("appr");
  const nope = byId("nope");
  const tweak = byId("tweak");
  const apprText = byId("apprText");

  const styleSelect = byId("styleSelect");
  const titleFont = byId("titleFont");
  const titleSize = byId("titleSize");
  const titleSizeVal = byId("titleSizeVal");
  const bodyFont = byId("bodyFont");
  const dropcapSelect = byId("dropcapSelect");

  const imgFile = byId("imgFile");

  const menu = byId("menu");
  const menuItems = byId("menuItems");
  const menuSearch = byId("menuSearch");

  /* =========================
     App state
     ========================= */
  let ALL = loadAll();
  let current = null;
  let currentBlockId = null;
  let previewMode = false;

  // Simple undo stack (for blocks HTML)
  let undoStack = [];
  let redoStack = [];

  function snapshotUndo(){
    if(!current) return;
    undoStack.push(JSON.stringify(current));
    if(undoStack.length > 50) undoStack.shift();
    redoStack = [];
  }

  function restoreState(json){
    try{
      const obj = JSON.parse(json);
      current = obj;
      renderEditor();
    } catch {}
  }

  /* =========================
     Articles list rendering
     ========================= */
  function renderList(){
    ALL = loadAll();
    const q = (searchInput.value || "").trim().toLowerCase();
    const list = ALL
      .slice()
      .sort((a,b) => (b.savedAt||"").localeCompare(a.savedAt||""))
      .filter(a => {
        if(!q) return true;
        const hay = `${a.title||""} ${a.byline||""}`.toLowerCase();
        return hay.includes(q);
      });

    cards.innerHTML = "";
    if(list.length === 0){
      cards.innerHTML = `<div class="muted" style="font-size:14px;padding:18px 0">No articles yet.</div>`;
      return;
    }

    for(const a of list){
      const desc = buildPreviewText(a).slice(0, 180) || "—";
      const badge = a.published ? "Published" : "Draft";
      const el = document.createElement("div");
      el.className = "card";
      el.innerHTML = `
        <div>
          <h3>${escapeHTML(a.title || "Untitled")}</h3>
          <p>${escapeHTML(desc)}</p>
        </div>
        <div class="badge">${badge}</div>
      `;
      el.addEventListener("click", () => openArticle(a.id));
      cards.appendChild(el);
    }
  }

  function buildPreviewText(article){
    // Use first paragraph-ish content
    const p = (article.blocks || []).find(b => b.type==="p" && stripHTML(b.html).trim());
    return p ? stripHTML(p.html).trim() : "";
  }

  /* =========================
     Editor rendering
     ========================= */
  function renderEditor(){
    if(!current) return;

    // Style toggles
    stage.classList.toggle("archived", current.style === "archived");
    stage.classList.toggle("locked", current.published && !isEditingPublished());

    // Meta
    kicker.textContent = current.kicker || "";
    title.textContent = current.title || "";
    byline.textContent = current.byline || "";
    dateEl.textContent = current.date || defaultDateStr();

    // Title settings
    title.style.fontFamily = `${current.titleFont}, Georgia, serif`;
    title.style.fontSize = `${current.titleSize || 48}px`;

    // Body default
    blocksEl.style.setProperty("--body-size", "18px");
    blocksEl.style.setProperty("--body-lh", "27px");
    blocksEl.style.fontFamily = `${current.bodyFont || "MillerText"}, Georgia, serif`;

    // Dropcap
    stageIn.classList.toggle("dropcap", current.dropcap === "on");

    // Sidebar controls sync
    styleSelect.value = current.style || "modern";
    titleFont.value = current.titleFont || "NYEgyptienne";
    titleSize.value = current.titleSize || 48;
    titleSizeVal.textContent = `${titleSize.value}px`;
    bodyFont.value = current.bodyFont || "MillerText";
    dropcapSelect.value = current.dropcap || "off";

    // Avatar
    if(current.avatarDataUrl){
      avatarImg.src = current.avatarDataUrl;
      avatarImg.style.display = "block";
    } else {
      avatarImg.style.display = "none";
      avatarImg.removeAttribute("src");
    }

    // Blocks
    blocksEl.innerHTML = "";
    (current.blocks || []).forEach((b, idx) => {
      const wrap = document.createElement("div");
      wrap.className = "block";
      wrap.dataset.id = b.id;
      wrap.draggable = !isLocked();

      wrap.innerHTML = `
        <div class="handle" title="Drag to reorder" aria-hidden="true"><div class="grip"></div></div>
        <div class="plusbtn" title="Add block">+</div>
        <div class="content"></div>
      `;

      const content = wrap.querySelector(".content");
      content.appendChild(renderBlockNode(b, idx));

      const plusbtn = wrap.querySelector(".plusbtn");
      plusbtn.addEventListener("click", (e) => {
        e.stopPropagation();
        focusBlock(b.id);
        openMenuNearElement(plusbtn, b.id);
      });

      // focus behavior
      wrap.addEventListener("click", () => focusBlock(b.id));

      // drag reorder
      wrap.addEventListener("dragstart", (e) => {
        if(isLocked()) return e.preventDefault();
        e.dataTransfer.setData("text/plain", b.id);
        e.dataTransfer.effectAllowed = "move";
        wrap.style.opacity = ".6";
      });
      wrap.addEventListener("dragend", () => wrap.style.opacity = "1");
      wrap.addEventListener("dragover", (e) => {
        if(isLocked()) return;
        e.preventDefault();
        e.dataTransfer.dropEffect = "move";
      });
      wrap.addEventListener("drop", (e) => {
        if(isLocked()) return;
        e.preventDefault();
        const fromId = e.dataTransfer.getData("text/plain");
        if(!fromId || fromId === b.id) return;
        snapshotUndo();
        reorderBlocks(fromId, b.id);
        saveCurrent("autosave");
        renderEditor();
      });

      blocksEl.appendChild(wrap);
    });

    // Related section UI (locked header, but user chooses items)
    renderRelated();

    // Preview mode toggles
    applyPreviewMode(previewMode);

    // Locked panel
    renderLockedPanel();

    // Ensure at least 1 paragraph
    if(!current.blocks || current.blocks.length === 0){
      current.blocks = [{ id: uid(), type:"p", html:"", font:null, align:"left" }];
    }

    // Persist meta edits handlers
    // (do once per render; safe due to re-render)
    bindMetaHandlers();

    // If no title size set
    if(!current.titleSize) current.titleSize = 48;
  }

  function renderBlockNode(b, idx){
    let node;

    const alignClass = b.align === "center" ? "align-center"
      : b.align === "justify" ? "align-justify"
      : "align-left";

    const fontStyle = b.font ? `font-family:${b.font}, Georgia, serif;` : "";

    if(b.type === "p"){
      node = document.createElement("div");
      node.className = `p editable ${alignClass}`;
      node.contentEditable = !isLocked();
      node.spellcheck = true;
      node.style.cssText += fontStyle;
      node.innerHTML = b.html || "";
      bindEditable(node, b, {type:"p"});
      bindParagraphEnterBehavior(node, b);
    }
    else if(b.type === "subhead"){
      node = document.createElement("div");
      const size = b.size === 36 ? "size36" : "size28";
      node.className = `subhead ${size} editable ${alignClass}`;
      node.contentEditable = !isLocked();
      node.spellcheck = false;
      node.style.cssText += fontStyle;
      node.innerHTML = b.html || "";
      bindEditable(node, b, {type:"subhead"});
    }
    else if(b.type === "pull"){
      node = document.createElement("div");
      node.className = `pull editable ${alignClass}`;
      node.contentEditable = !isLocked();
      node.spellcheck = false;
      node.style.cssText += fontStyle;
      node.innerHTML = b.html || "";
      bindEditable(node, b, {type:"pull"});
    }
    else if(b.type === "bullet"){
      node = document.createElement("div");
      node.className = "bullet";
      node.innerHTML = `
        <div aria-hidden="true">
          ${RED_ARROW_SVG()}
        </div>
        <div>
          <div class="bullet-title editable ${alignClass}" contenteditable="${!isLocked()}" spellcheck="false"></div>
          <div class="bullet-body editable ${alignClass}" contenteditable="${!isLocked()}" spellcheck="true"></div>
        </div>
      `;
      const bt = node.querySelector(".bullet-title");
      const bb = node.querySelector(".bullet-body");
      bt.style.cssText += (b.titleFont ? `font-family:${b.titleFont}, Arial, sans-serif;` : "");
      bb.style.cssText += (b.bodyFont ? `font-family:${b.bodyFont}, Georgia, serif;` : "");

      bt.innerHTML = b.titleHtml || "";
      bb.innerHTML = b.bodyHtml || "";

      bindBullet(bt, bb, b);
    }
    else if(b.type === "image"){
      node = document.createElement("div");
      node.className = "imgwrap";
      node.innerHTML = `
        <div class="imgbox">
          <div class="imgadd">
            <div style="font-size:13px">Add an image</div>
            <button type="button">Upload</button>
            <div style="font-size:12px;color:#888">Captions below in Chap.</div>
          </div>
          <img style="display:none" />
        </div>
        <div class="caption editable" contenteditable="${!isLocked()}" spellcheck="false"></div>
      `;
      const img = node.querySelector("img");
      const add = node.querySelector(".imgadd");
      const btn = node.querySelector("button");
      const cap = node.querySelector(".caption");

      cap.innerHTML = b.caption || "";

      if(b.dataUrl){
        img.src = b.dataUrl;
        img.style.display = "block";
        add.style.display = "none";
      } else {
        img.style.display = "none";
        add.style.display = "grid";
      }

      btn.addEventListener("click", () => {
        if(isLocked()) return;
        currentBlockId = b.id;
        imgFile.click();
      });

      cap.addEventListener("focus", () => focusBlock(b.id));
      cap.addEventListener("input", () => {
        b.caption = cap.innerHTML;
        queueAutosave();
      });
      cap.addEventListener("blur", () => { cap.innerHTML = smartenPlain(stripHTML(cap.innerHTML)); b.caption = cap.innerHTML; queueAutosave(true); });

      node.classList.add(alignClass);
    }
    else {
      // fallback
      node = document.createElement("div");
      node.textContent = "Unsupported block.";
    }

    // add per-block quick controls (font + alignment) on focus via menu
    node.addEventListener("focus", () => focusBlock(b.id), true);

    return node;
  }

  function bindParagraphEnterBehavior(node, b){
    node.addEventListener("keydown", (e) => {
      if(isLocked()) return;

      // Slash menu (only if "/" is first char OR user presses "/" and block is empty)
      if(e.key === "/" && (stripHTML(node.innerHTML).trim().length === 0)){
        setTimeout(() => openMenuAtCaret(b.id), 0);
        return;
      }

      // Enter behavior:
      // - Single Enter: new line inside paragraph (we'll treat as <br>)
      // - Double Enter quickly: split into a new paragraph block (Medium feel)
      if(e.key === "Enter"){
        if(e.shiftKey) return; // shift+enter normal

        // detect "double enter" by checking if caret at end and previous char is line break OR paragraph empty line
        // We'll approximate: if selection at end AND last two chars are <br><br> created by Enter twice.
        // Instead: handle as:
        // 1) prevent default
        // 2) insert <br>
        // 3) if caret is on an empty line (two brs), create new paragraph block after.
        e.preventDefault();

        // Insert line break
        insertHTMLAtCursor("<br>");

        // Check if user just created an empty line (…<br><br> at end)
        const html = node.innerHTML;
        const tail = html.slice(-8).toLowerCase();
        const almostDouble = tail.includes("<br><br>") || tail.endsWith("<br><br>") || stripHTML(html).trim()==="";

        // If paragraph already ends with <br><br>, we create new paragraph
        // We'll do a stricter check: if html ends with <br><br> or <br><br>&nbsp;
        const normalized = html.replace(/&nbsp;/g," ").toLowerCase().trim();
        if(normalized.endsWith("<br><br>") || normalized.endsWith("<br><br><br>")){
          // remove the extra breaks at end
          node.innerHTML = normalized.replace(/(<br>)+$/i, "").trim();
          b.html = node.innerHTML;
          snapshotUndo();
          addBlockAfter(b.id, { id: uid(), type:"p", html:"", font:null, align:"left" });
          renderEditor();
          focusBlock(getNextBlockId(b.id));
        } else {
          b.html = node.innerHTML;
          queueAutosave();
        }
      }
    });
  }

  function getNextBlockId(afterId){
    const idx = current.blocks.findIndex(x => x.id === afterId);
    if(idx < 0) return afterId;
    return current.blocks[Math.min(idx+1, current.blocks.length-1)].id;
  }

  function addBlockAfter(afterId, block){
    const idx = current.blocks.findIndex(b => b.id === afterId);
    if(idx < 0) current.blocks.push(block);
    else current.blocks.splice(idx+1, 0, block);
  }

  function reorderBlocks(fromId, toId){
    const fromIdx = current.blocks.findIndex(b => b.id === fromId);
    const toIdx = current.blocks.findIndex(b => b.id === toId);
    if(fromIdx<0 || toIdx<0) return;
    const [moved] = current.blocks.splice(fromIdx, 1);
    const newIdx = fromIdx < toIdx ? toIdx-1 : toIdx;
    current.blocks.splice(newIdx, 0, moved);
  }

  function bindEditable(node, block, meta){
    node.addEventListener("focus", () => focusBlock(block.id));
    node.addEventListener("input", () => {
      block.html = node.innerHTML;
      queueAutosave();
    });

    node.addEventListener("blur", () => {
      // smarten punctuation on blur
      const plain = stripHTML(node.innerHTML);
      const smart = smartenPlain(plain);
      // keep allowed inline tags by reapplying from existing HTML:
      // simplest: set to smart text (keeps b/i/u? no)
      // BUT user specifically allows b/i/u from paste; we keep it by smartening text nodes only during paste.
      // On blur: we only do em dash conversion in HTML string (safe-ish).
      node.innerHTML = node.innerHTML.replace(/--/g,"—").replace(/(\w)'(\w)/g,"$1’$2").replace(/(^|\s)'/g,"$1‘").replace(/'/g,"’")
        .replace(/(^|\s)"/g,'$1“').replace(/"/g,"”");
      block.html = node.innerHTML;
      queueAutosave(true);
    });

    // paste sanitization
    node.addEventListener("paste", (e) => {
      if(isLocked()) return;
      e.preventDefault();
      const cb = e.clipboardData;
      const html = cb.getData("text/html");
      const text = cb.getData("text/plain");

      if(html){
        const clean = sanitizeClipboardHTML(html);
        insertHTMLAtCursor(clean ? clean : escapeHTML(smartenPlain(text)));
      } else {
        insertHTMLAtCursor(escapeHTML(smartenPlain(text)));
      }
      block.html = node.innerHTML;
      queueAutosave(true);
    });

    // quick slash menu if user types "/" at beginning of line
    node.addEventListener("keyup", (e) => {
      if(isLocked()) return;
      if(e.key === "/" && stripHTML(node.innerHTML).trim() === "/"){
        // remove the slash from content and open menu
        node.innerHTML = "";
        block.html = "";
        openMenuAtCaret(block.id);
      }
    });
  }

  function bindBullet(bt, bb, block){
    bt.addEventListener("focus", () => focusBlock(block.id));
    bb.addEventListener("focus", () => focusBlock(block.id));

    const onInput = () => queueAutosave();
    bt.addEventListener("input", () => { block.titleHtml = bt.innerHTML; onInput(); });
    bb.addEventListener("input", () => { block.bodyHtml = bb.innerHTML; onInput(); });

    const onBlurSmart = (el, key) => {
      el.addEventListener("blur", () => {
        el.innerHTML = el.innerHTML.replace(/--/g,"—").replace(/(\w)'(\w)/g,"$1’$2").replace(/(^|\s)'/g,"$1‘").replace(/'/g,"’")
          .replace(/(^|\s)"/g,'$1“').replace(/"/g,"”");
        block[key] = el.innerHTML;
        queueAutosave(true);
      });
      el.addEventListener("paste", (e) => {
        if(isLocked()) return;
        e.preventDefault();
        const cb = e.clipboardData;
        const html = cb.getData("text/html");
        const text = cb.getData("text/plain");
        if(html){
          const clean = sanitizeClipboardHTML(html);
          insertHTMLAtCursor(clean ? clean : escapeHTML(smartenPlain(text)));
        } else {
          insertHTMLAtCursor(escapeHTML(smartenPlain(text)));
        }
        block[key] = el.innerHTML;
        queueAutosave(true);
      });
    };
    onBlurSmart(bt, "titleHtml");
    onBlurSmart(bb, "bodyHtml");
  }

  function bindMetaHandlers(){
    // Kicker plus simply focuses kicker
    kickerPlus.onclick = () => kicker.focus();

    // Meta edits
    kicker.oninput = () => { current.kicker = kicker.textContent; queueAutosave(); };
    title.oninput = () => { current.title = title.textContent; queueAutosave(); };
    byline.oninput = () => { current.byline = byline.textContent; queueAutosave(); };
    dateEl.oninput = () => { current.date = dateEl.textContent; queueAutosave(); };

    // smarten meta on blur
    [kicker,title,byline,dateEl].forEach(el => {
      el.onpaste = (e) => {
        if(isLocked()) return;
        e.preventDefault();
        const text = e.clipboardData.getData("text/plain");
        insertHTMLAtCursor(escapeHTML(smartenPlain(text)));
        queueAutosave(true);
      };
      el.onblur = () => {
        el.textContent = smartenPlain(el.textContent || "");
        current.kicker = kicker.textContent;
        current.title = title.textContent;
        current.byline = byline.textContent;
        current.date = dateEl.textContent || defaultDateStr();
        queueAutosave(true);
      };
    });

    // Avatar
