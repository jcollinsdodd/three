  /* =========================
     Locked state helpers
     ========================= */
  function isLocked(){
    return current && current.published && !isEditingPublished() || previewMode;
  }
  let editingPublished = false;
  function isEditingPublished(){ return editingPublished; }
  function toggleEditingPublished(){ editingPublished = !editingPublished; }

  /* =========================
     Save / Publish behavior
     ========================= */
  function saveCurrent(reason="manual"){
    if(!current) return;
    current.savedAt = new Date().toISOString();

    // persist profile from byline + avatar so user doesn't redo each time
    const profile = loadProfile() || {};
    profile.byline = current.byline || profile.byline || "";
    profile.avatarDataUrl = current.avatarDataUrl || profile.avatarDataUrl || null;
    saveProfile(profile);

    // upsert
    const idx = ALL.findIndex(a => a.id === current.id);
    if(idx >= 0) ALL[idx] = current;
    else ALL.unshift(current);
    saveAll(ALL);
  }

  let autosaveTimer = null;
  function queueAutosave(force=false){
    if(!current) return;
    if(force){
      saveCurrent("autosave");
      return;
    }
    clearTimeout(autosaveTimer);
    autosaveTimer = setTimeout(() => saveCurrent("autosave"), 450);
  }

  function publish(){
    if(!current) return;

    if(!current.title.trim()){
      alert("Add a title before publishing.");
      return;
    }

    const now = new Date();
    if(!current.published){
      current.published = true;
      current.publishedAt = now.toISOString();
      current.updatedAt = null;
      current.updateCount = 0;
    } else {
      // publishing again is essentially “update”
      current.updatedAt = now.toISOString();
      current.updateCount = (current.updateCount || 0) + 1;
    }

    saveCurrent("publish");
    renderEditor();
    renderLastUpdated();
    applyPreviewMode(true);
  }

  /* =========================
     Open / create
     ========================= */
  function openArticle(id){
    ALL = loadAll();
    const found = ALL.find(a => a.id === id);
    if(!found){
      alert("Could not find that article.");
      return;
    }
    current = found;

    // Apply saved profile if missing
    const profile = loadProfile();
    if(profile){
      if(!current.byline) current.byline = profile.byline || "";
      if(!current.avatarDataUrl) current.avatarDataUrl = profile.avatarDataUrl || null;
    }

    previewMode = false;
    editingPublished = false;
    show(viewEditor);
    renderEditor();
    focusBlock(current.blocks[0]?.id);
  }

  function createAndOpen(){
    current = newArticle();

    // Seed profile
    const profile = loadProfile();
    if(profile){
      current.byline = profile.byline || "";
      current.avatarDataUrl = profile.avatarDataUrl || null;
    }

    // Set date to “today” by default (editable)
    current.date = defaultDateStr();

    snapshotUndo();
    saveCurrent("create");
    show(viewEditor);
    renderEditor();
    // focus title for the “breathing” feel
    setTimeout(() => title.focus(), 30);
  }

