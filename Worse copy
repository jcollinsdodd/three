    [...blocksEl.querySelectorAll(".block")].forEach(b => b.classList.toggle("focused", b.dataset.id === id));
  }

  function openMenuAtCaret(blockId){
    const rect = getCaretRect();
    const x = rect ? rect.left : window.innerWidth/2;
    const y = rect ? rect.bottom + 8 : 180;
    openMenu(x, y, blockId);
  }

  function openMenuNearElement(el, blockId){
    const r = el.getBoundingClientRect();
    openMenu(r.right + 10, r.top - 10, blockId);
  }

  const MENU_DEFS = [
    { key:"p", name:"Paragraph", desc:"Body copy (18px / 27px)", hint:"Enter twice = new paragraph" },
    { key:"sub28", name:"Subheading (28px)", desc:"NYEgyptienne / strong beat" },
    { key:"sub36", name:"Subheading (36px)", desc:"Bigger beat / section lead" },
    { key:"pull", name:"Pull quote", desc:"Big quote with mark" },
    { key:"bullet", name:"Bullet", desc:"Red arrow + Chap headline" },
    { key:"image", name:"Image", desc:"Upload + Chap caption" },
    { key:"font", name:"Font (this block)", desc:"Pick font for this block" },
    { key:"align", name:"Alignment", desc:"Left / Center / Justify (BETA)" },
    { key:"delete", name:"Delete block", desc:"Remove this block" },
  ];

  function openMenu(x,y, blockId){
    if(isLocked()) return;
    menu.style.display = "block";
    menu.style.left = Math.min(x, window.innerWidth - 300) + "px";
    menu.style.top  = Math.min(y, window.innerHeight - 340) + "px";
    menuSearch.value = "";
    renderMenuItems("");
    menuSearch.focus();

    menu.dataset.blockId = blockId || currentBlockId || "";
  }

  function closeMenu(){
    menu.style.display = "none";
    menu.dataset.blockId = "";
  }

  function renderMenuItems(filter){
    const f = (filter||"").trim().toLowerCase();
    const items = MENU_DEFS.filter(i => !f || (i.name+i.desc).toLowerCase().includes(f));
    menuItems.innerHTML = "";
    items.forEach(item => {
      const el = document.createElement("div");
      el.className = "item";
      el.innerHTML = `
        <div class="left">
          <div class="name">${item.name}</div>
          <div class="desc">${item.desc}</div>
        </div>
        <div class="hint">${item.hint || ""}</div>
      `;
      el.onclick = () => {
        const bid = menu.dataset.blockId || currentBlockId;
        handleMenuAction(item.key, bid);
        closeMenu();
      };
      menuItems.appendChild(el);
    });
  }

  menuSearch.addEventListener("input", () => renderMenuItems(menuSearch.value));
  window.addEventListener("click", (e) => {
    if(menu.style.display==="block" && !menu.contains(e.target)) closeMenu();
  });
  window.addEventListener("keydown", (e) => {
    if(e.key === "Escape") closeMenu();
  });

  function handleMenuAction(key, blockId){
    if(isLocked()) return;
    if(!blockId) return;

    const idx = current.blocks.findIndex(b => b.id === blockId);
    if(idx < 0) return;

    snapshotUndo();

    if(key === "p"){
      current.blocks.splice(idx+1, 0, { id: uid(), type:"p", html:"", font:null, align:"left" });
      renderEditor();
      focusBlock(current.blocks[idx+1].id);
      scrollBlockIntoView(current.blocks[idx+1].id);
      return;
    }
    if(key === "sub28"){
      current.blocks.splice(idx+1, 0, { id: uid(), type:"subhead", size:28, html:"", font:null, align:"left" });
      renderEditor(); focusBlock(current.blocks[idx+1].id); scrollBlockIntoView(current.blocks[idx+1].id); return;
    }
    if(key === "sub36"){
      current.blocks.splice(idx+1, 0, { id: uid(), type:"subhead", size:36, html:"", font:null, align:"left" });
      renderEditor(); focusBlock(current.blocks[idx+1].id); scrollBlockIntoView(current.blocks[idx+1].id); return;
    }
    if(key === "pull"){
      current.blocks.splice(idx+1, 0, { id: uid(), type:"pull", html:"", font:"NYEgyptienne", align:"left" });
      renderEditor(); focusBlock(current.blocks[idx+1].id); scrollBlockIntoView(current.blocks[idx+1].id); return;
    }
    if(key === "bullet"){
      current.blocks.splice(idx+1, 0, {
        id: uid(),
        type:"bullet",
        titleHtml:"",
        bodyHtml:"",
        titleFont:"Chap",
        bodyFont:"MillerText",
        align:"left"
      });
      renderEditor(); focusBlock(current.blocks[idx+1].id); scrollBlockIntoView(current.blocks[idx+1].id); return;
    }
    if(key === "image"){
      current.blocks.splice(idx+1, 0, { id: uid(), type:"image", dataUrl:null, caption:"", align:"left" });
      renderEditor(); focusBlock(current.blocks[idx+1].id); scrollBlockIntoView(current.blocks[idx+1].id); return;
    }
    if(key === "delete"){
      if(current.blocks.length === 1) {
        current.blocks[0].html = "";
      } else {
        current.blocks.splice(idx, 1);
      }
      renderEditor();
      return;
    }
    if(key === "font"){
      const font = prompt(
        "Font for this block (type one):\nMillerText / NYEgyptienne / Chap / ChapLight / Elderkin",
        current.blocks[idx].font || ""
      );
      if(font !== null){
        current.blocks[idx].font = (font||"").trim() || null;
        renderEditor();
      }
      return;
    }
    if(key === "align"){
      const a = current.blocks[idx].align || "left";
      const next = a === "left" ? "center" : a === "center" ? "justify" : "left";
      current.blocks[idx].align = next;
      // show a fun beta tag only conceptually: we do it in sidebar & menu text, not in content
      renderEditor();
      return;
    }
  }

  function scrollBlockIntoView(id){
