<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Writer</title>
  <style>
    /* =========================
       Fonts (update URLs if needed)
       ========================= */
    @font-face{
      font-family:"MillerText";
      src:url("./Miller_Text_Roman.ttf") format("truetype");
      font-weight:400;
      font-style:normal;
      font-display:swap;
    }
    @font-face{
      font-family:"MillerText";
      src:url("./Miller_Text_Italic.ttf") format("truetype");
      font-weight:400;
      font-style:italic;
      font-display:swap;
    }
    @font-face{
      font-family:"MillerText";
      src:url("./Miller_Text_Bold.ttf") format("truetype");
      font-weight:700;
      font-style:normal;
      font-display:swap;
    }

    @font-face{
      font-family:"Chap";
      src:url("./Chap.woff2") format("woff2");
      font-weight:400;
      font-style:normal;
      font-display:swap;
    }
    @font-face{
      font-family:"ChapLight";
      src:url("./Chap-Light.woff2") format("woff2");
      font-weight:300;
      font-style:normal;
      font-display:swap;
    }

    @font-face{
      font-family:"NYEgyptienne";
      src:url("./NY_Egyptienne_Legacy_Romans_Variable.woff2") format("woff2");
      font-weight:100 900;
      font-style:normal;
      font-display:swap;
    }

    @font-face{
      font-family:"Elderkin";
      src:url("./Elderkin.woff2") format("woff2");
      font-weight:400;
      font-style:normal;
      font-display:swap;
    }

    /* =========================
       Design tokens
       ========================= */
    :root{
      --bg:#fff;
      --ink:#111;
      --muted:#6b6b6b;
      --hair:#e8e8e8;
      --accent:#db2800;
      --col:600px;            /* NYMag-ish body column */
      --gutter:28px;          /* page gutter */
      --rhythm:20px;          /* paragraph bottom margin */
      --body-size:18px;
      --body-lh:27px;

      --title-min:35px;
      --title-max:55px;

      --ui:#f7f7f7;
      --ui2:#f1f1f1;
      --uiBorder:#d9d9d9;

      --shadow:0 10px 30px rgba(0,0,0,.08);
      --radius:14px;
    }

    *{box-sizing:border-box}
    html,body{height:100%}
    body{
      margin:0;
      background:var(--bg);
      color:var(--ink);
      font-family:system-ui,-apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif;
    }
    a{color:inherit}
    button,input,select{font:inherit}

    /* =========================
       App shell
       ========================= */
    .topbar{
      position:sticky; top:0; z-index:60;
      background:#fff;
      border-bottom:1px solid var(--hair);
    }
    .topbar-inner{
      max-width:1120px;
      margin:0 auto;
      padding:12px var(--gutter);
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:16px;
    }
    .brand{
      display:flex; align-items:center; gap:10px;
      user-select:none;
      cursor:pointer;
    }
    .dots{
      width:26px; height:26px;
      display:grid;
      grid-template-columns:repeat(2,1fr);
      gap:4px;
    }
    .dot{width:10px;height:10px;border-radius:999px;background:#111}
    .dot:nth-child(2){opacity:.9}
    .dot:nth-child(3){opacity:.75}
    .dot:nth-child(4){opacity:.55}
    .brand-title{
      letter-spacing:.16em;
      text-transform:uppercase;
      font-size:12px;
      color:#111;
    }

    .top-actions{
      display:flex; align-items:center; gap:10px;
    }

    .iconbtn{
      width:34px;height:34px;
      border-radius:999px;
      border:1px solid var(--hair);
      background:#fff;
      display:grid; place-items:center;
      cursor:pointer;
    }
    .iconbtn:hover{background:#fafafa}

    .pill{
      border:1px solid var(--hair);
      background:#fff;
      height:34px;
      padding:0 12px;
      border-radius:999px;
      display:flex; align-items:center; gap:8px;
      cursor:pointer;
      user-select:none;
    }
    .pill:hover{background:#fafafa}
    .kbd{
      font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;
      font-size:12px;
      color:var(--muted);
    }

    .page{
      max-width:1120px;
      margin:0 auto;
      padding:18px var(--gutter) 60px;
    }

    /* =========================
       Views
       ========================= */
    .view{display:none}
    .view.active{display:block}

    /* =========================
       Landing (simple)
       ========================= */
    .landing{
      padding:70px 0 20px;
      display:grid;
      place-items:center;
      text-align:center;
    }
    .landing h1{
      font-family:NYEgyptienne, Georgia, serif;
      font-weight:600;
      font-size:52px;
      line-height:1.05;
      margin:0 0 18px;
      letter-spacing:-.02em;
    }
    .landing p{
      margin:0 0 22px;
      color:var(--muted);
      max-width:560px;
      line-height:1.4;
    }
    .primary{
      border:1px solid #111;
      background:#fff;
      padding:10px 16px;
      cursor:pointer;
      border-radius:8px;
    }
    .primary:hover{background:#f7f7f7}

    /* =========================
       Articles list
       ========================= */
    .list-head{
      display:flex; align-items:flex-end; justify-content:space-between; gap:14px;
      padding:14px 0 10px;
      border-bottom:1px solid var(--hair);
      margin-bottom:18px;
    }
    .list-title{
      font-family:NYEgyptienne, Georgia, serif;
      font-weight:650;
      font-size:30px;
      margin:0;
    }
    .search{
      display:flex; align-items:center; gap:10px;
    }
    .search input{
      width:320px;
      max-width:55vw;
      height:36px;
      border-radius:10px;
      border:1px solid var(--hair);
      padding:0 12px;
      outline:none;
    }
    .cards{
      display:flex;
      flex-direction:column;
      gap:14px;
    }
    .card{
      border:1px solid var(--hair);
      border-radius:16px;
      padding:14px 16px;
      display:grid;
      grid-template-columns:1fr auto;
      gap:10px;
      cursor:pointer;
      background:#fff;
    }
    .card:hover{background:#fafafa}
    .card h3{
      font-family:NYEgyptienne, Georgia, serif;
      font-weight:650;
      font-size:22px;
      margin:0 0 6px;
      line-height:1.15;
    }
    .card p{
      margin:0;
      font-family:MillerText, Georgia, serif;
      font-size:16px;
      line-height:1.35;
      color:#333;
      max-width:760px;
    }
    .badge{
      font-size:12px;
      border:1px solid var(--hair);
      border-radius:999px;
      padding:6px 10px;
      color:#444;
      align-self:start;
      white-space:nowrap;
    }
    .muted{color:var(--muted)}
    .row{
      display:flex; gap:10px; flex-wrap:wrap; align-items:center;
    }

    /* =========================
       Editor layout
       ========================= */
    .editor-shell{
      display:grid;
      grid-template-columns: 1fr 320px;
      gap:20px;
      align-items:start;
    }
    @media (max-width: 980px){
      .editor-shell{grid-template-columns:1fr}
      .side{position:relative; top:auto}
    }

    .stage{
      background:#fff;
      border:1px solid var(--hair);
      border-radius:18px;
      overflow:hidden;
    }
    .stage-toprule{border-top:1px solid var(--hair)}
    .stage-in{
      padding: 18px 0 18px;
    }

    /* Strict column */
    .col{
      width:var(--col);
      max-width: calc(100% - (var(--gutter) * 2));
      margin: 0 auto;
      position:relative;
    }

    /* NYMag-ish horizontal rules as layout separators */
    .hr{
      width:100%;
      border-top:1px solid var(--hair);
      margin:16px 0;
    }
    .hr.tight{margin:10px 0}
    .hr.spacious{margin:22px 0}

    /* Meta header (kicker, title, byline row, date row) */
    .kicker{
      font-family:Chap, Arial, sans-serif;
      letter-spacing:.16em;
      text-transform:uppercase;
      font-size:12px;
      margin: 6px 0 10px;
      color:#111;
      display:inline-flex;
      gap:10px;
      align-items:center;
    }
    .kicker .plus{
      width:36px;height:36px;border-radius:999px;
      border:1px solid var(--hair);
      display:grid; place-items:center;
      cursor:pointer;
      background:#fff;
      margin-right:8px;
      flex:0 0 auto;
    }
    .kicker .plus:hover{background:#fafafa}
    .kicker-edit{
      outline:none;
      border-radius:8px;
      padding:2px 6px;
      min-width:140px;
    }
    .kicker-edit:empty:before{
      content:"Add kicker";
      color:var(--muted);
    }

    .title{
      font-family:NYEgyptienne, Georgia, serif;
      font-weight:650;
      text-align:center;
      letter-spacing:-.02em;
      line-height:1.05;
      margin: 6px 0 18px;
      outline:none;
      padding: 8px 10px;
      border-radius:12px;
    }
    .title:empty:before{
      content:"Title";
      color:#b0b0b0;
    }

    /* Byline row (NYMag-like: avatar + “By Name, description…”) */
    .byline-row{
      display:flex;
      align-items:center;
      gap:12px;
      margin: 0 0 10px;
    }
    .avatar{
      width:40px; height:40px;
      border-radius:999px;
      border:1px solid var(--hair);
      overflow:hidden;
      background:#fafafa;
      flex:0 0 auto;
      position:relative;
      cursor:pointer;
    }
    .avatar img{width:100%;height:100%;object-fit:cover;display:block}
    .avatar .add{
      position:absolute; inset:0;
      display:grid; place-items:center;
      font-size:12px;
      color:#666;
      background:rgba(255,255,255,.88);
      opacity:0;
      transition:opacity .15s ease;
    }
    .avatar:hover .add{opacity:1}

    .byline{
      font-family:MillerText, Georgia, serif;
      font-size:16px;
      color:#333;
      line-height:1.3;
      outline:none;
      border-radius:10px;
      padding:4px 6px;
      flex:1 1 auto;
    }
    .byline:empty:before{
      content:"By Your Name, a staff writer…";
      color:#9c9c9c;
    }

    .date-row{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:12px;
      padding: 10px 0 6px;
    }
    .date{
      font-family:Chap, Arial, sans-serif;
      letter-spacing:.18em;
      text-transform:uppercase;
      font-size:12px;
      color:#111;
      outline:none;
      border-radius:10px;
      padding:2px 6px;
    }
    .date:empty:before{
      content:"Date";
      color:#9c9c9c;
    }
    .mini-actions{
      display:flex; align-items:center; gap:10px;
      color:#111;
    }
    .mini-actions .tiny{
      display:flex; align-items:center; gap:7px;
      padding:6px 10px;
      border-radius:999px;
      border:1px solid var(--hair);
      cursor:pointer;
      background:#fff;
      font-size:12px;
      user-select:none;
    }
    .mini-actions .tiny:hover{background:#fafafa}

    /* =========================
       Blocks
       ========================= */
    .blocks{padding: 8px 0 20px}
    .block{
      position:relative;
      padding-left:46px; /* room for handle + plus */
    }
    .block + .block{margin-top:10px}

    .handle{
      position:absolute;
      left:6px; top:8px;
      width:34px;height:34px;border-radius:999px;
      border:1px solid var(--hair);
      display:grid; place-items:center;
      background:#fff;
      cursor:grab;
      user-select:none;
    }
    .handle:active{cursor:grabbing}
    .handle .grip{
      width:12px;height:12px;
      background:
        radial-gradient(circle at 2px 2px,#777 2px,transparent 3px),
        radial-gradient(circle at 10px 2px,#777 2px,transparent 3px),
        radial-gradient(circle at 2px 10px,#777 2px,transparent 3px),
        radial-gradient(circle at 10px 10px,#777 2px,transparent 3px);
      opacity:.8;
    }

    .plusbtn{
      position:absolute;
      left:6px; top:50%;
      transform:translateY(-50%);
      width:34px;height:34px;border-radius:999px;
      border:1px solid var(--hair);
      display:grid; place-items:center;
      background:#fff;
      cursor:pointer;
      user-select:none;
      opacity:0;
      transition:opacity .12s ease;
    }
    .block.focused .plusbtn{opacity:1}
    .plusbtn:hover{background:#fafafa}

    .editable{
      outline:none;
      border-radius:12px;
      padding:6px 10px;
    }
    .p{
      font-family:MillerText, Georgia, serif;
      font-size:var(--body-size);
      line-height:var(--body-lh);
      margin:0;
      color:#111;
      margin-bottom: var(--rhythm);
      min-height: 1.2em;
    }
    .p:empty:before{content:"Write…"; color:#b4b4b4}

    .subhead{
      font-family:NYEgyptienne, Georgia, serif;
      font-weight:650;
      margin: 8px 0 10px;
      letter-spacing:-.01em;
      line-height:1.1;
      color:#111;
      padding:6px 10px;
      border-radius:12px;
      outline:none;
    }
    .subhead.size28{font-size:28px}
    .subhead.size36{font-size:36px}
    .subhead:empty:before{content:"Subheading"; color:#b4b4b4}

    /* Pull quote (NYMag-ish, with big mark) */
    .pull{
      font-family:NYEgyptienne, Georgia, serif;
      font-weight:650;
      font-size:38px;
      line-height:1.06;
      margin: 10px 0 18px;
      position:relative;
      padding: 8px 10px 8px 46px;
      border-radius:14px;
      outline:none;
    }
    .pull:before{
      content:"“";
      position:absolute;
      left:10px; top:-6px;
      font-size:64px;
      line-height:1;
      color:#111;
      opacity:.95;
    }
    .pull:empty:before{content:"“";} /* keep mark even empty */
    .pull:empty:after{
      content:"Pull quote";
      color:#b4b4b4;
      margin-left:6px;
      font-size:20px;
      font-family:MillerText, Georgia, serif;
      font-weight:400;
    }

    /* Bullet callout (red arrow + big chap title + supporting line) */
    .bullet{
      display:grid;
      grid-template-columns: 24px 1fr;
      gap:10px;
      align-items:start;
      margin: 14px 0 18px;
      padding: 8px 10px;
      border-radius:14px;
    }
    .bullet svg{margin-top:6px}
    .bullet-title{
      font-family:Chap, Arial, sans-serif;
      font-weight:400;
      font-size:44px;
      line-height:1.02;
      letter-spacing:-.01em;
      margin:0 0 8px;
      outline:none;
      border-radius:10px;
      padding:4px 6px;
    }
    .bullet-title:empty:before{content:"Bullet headline"; color:#b4b4b4}
    .bullet-body{
      font-family:MillerText, Georgia, serif;
      font-size:18px;
      line-height:1.35;
      color:#111;
      outline:none;
      border-radius:10px;
      padding:4px 6px;
    }
    .bullet-body:empty:before{content:"Optional supporting line…"; color:#b4b4b4}

    /* Image block + caption */
    .imgwrap{
      margin: 6px 0 18px;
      border-radius:18px;
      overflow:hidden;
    }
    .imgbox{
      width:100%;
      background:#f5f5f5;
      border:1px solid var(--hair);
      border-radius:18px;
      overflow:hidden;
      position:relative;
      min-height:220px;
      display:grid; place-items:center;
    }
    .imgbox img{width:100%;height:auto;display:block}
    .imgbox .imgadd{
      position:absolute; inset:0;
      display:grid; place-items:center;
      gap:10px;
      text-align:center;
      color:#666;
      font-family:system-ui,-apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif;
      padding:20px;
    }
    .imgbox .imgadd button{
      border:1px solid #111;
      background:#fff;
      padding:8px 12px;
      border-radius:10px;
      cursor:pointer;
    }
    .imgbox .imgadd button:hover{background:#f7f7f7}
    .caption{
      margin-top:8px;
      font-family:ChapLight, Chap, Arial, sans-serif;
      font-size:12px;
      letter-spacing:.06em;
      color:#111;
      outline:none;
      padding:4px 6px;
      border-radius:10px;
    }
    .caption:empty:before{content:"Caption (Chap)"; color:#b4b4b4}

    /* Drop cap (first paragraph only) */
    .dropcap .p:first-letter{
      float:left;
      font-family:Elderkin, NYEgyptienne, Georgia, serif;
      font-size:72px;
      line-height:.85;
      padding: 6px 10px 0 0;
      font-weight:700;
    }

    /* =========================
       Preview / Published rendering container
       ========================= */
    .render{
      padding: 0 0 14px;
    }
    .render .p{padding:0 10px} /* keep same rhythm but no editable padding artifacts */
    .render .subhead, .render .pull, .render .bullet, .render .caption, .render .bullet-title, .render .bullet-body{
      padding:0;
      border-radius:0;
    }
    .render .block{padding-left:0}
    .render .handle,.render .plusbtn{display:none}
    .render .title{pointer-events:none}
    .render .byline,.render .date,.render .kicker-edit{pointer-events:none}

    .last-updated{
      font-family:MillerText, Georgia, serif;
      font-style:italic;
      color:#333;
      margin: 24px auto 14px;
      width:var(--col);
      max-width: calc(100% - (var(--gutter) * 2));
      padding: 0 10px;
    }

    /* =========================
       Side panel (settings + approve/no/tweak)
       ========================= */
    .side{
      position:sticky;
      top:70px;
      display:flex;
      flex-direction:column;
      gap:14px;
    }
    .panel{
      border:1px solid var(--hair);
      border-radius:18px;
      padding:14px;
      background:#fff;
    }
    .panel h4{
      margin:0 0 10px;
      font-size:12px;
      letter-spacing:.18em;
      text-transform:uppercase;
      color:#111;
    }
    .panel .small{font-size:12px;color:var(--muted);line-height:1.4}
    .seg{
      display:flex; gap:8px; flex-wrap:wrap;
      margin-top:10px;
    }
    .seg button{
      border:1px solid var(--hair);
      background:#fff;
      border-radius:999px;
      padding:8px 10px;
      cursor:pointer;
      font-size:12px;
    }
    .seg button.active{
      border-color:#111;
    }

    .field{
      display:grid;
      gap:6px;
      margin-top:10px;
    }
    .field label{
      font-size:12px;
      color:#111;
      letter-spacing:.05em;
    }
    .field select,.field input[type="range"]{
      width:100%;
    }
    .field select{
      height:36px;
      border-radius:12px;
      border:1px solid var(--hair);
      padding:0 10px;
      background:#fff;
    }
    .rangeRow{
      display:grid;
      grid-template-columns: 1fr 60px;
      align-items:center;
      gap:10px;
    }
    .rangeVal{
      font-size:12px;
      color:#444;
      text-align:right;
    }

    /* =========================
       Floating slash menu
       ========================= */
    .menu{
      position:fixed;
      z-index:1000;
      width:280px;
      border:1px solid var(--hair);
      border-radius:16px;
      background:#fff;
      box-shadow:var(--shadow);
      overflow:hidden;
      display:none;
    }
    .menu .menuhead{
      padding:10px 12px;
      background:var(--ui);
      border-bottom:1px solid var(--hair);
      display:flex; justify-content:space-between; align-items:center;
      gap:10px;
    }
    .menu .menuhead input{
      width:100%;
      height:32px;
      border-radius:10px;
      border:1px solid var(--uiBorder);
      padding:0 10px;
      outline:none;
      font-size:12px;
    }
    .menu .item{
      padding:10px 12px;
      cursor:pointer;
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:10px;
      border-bottom:1px solid #f1f1f1;
    }
    .menu .item:hover{background:#fafafa}
    .menu .left{
      display:flex; flex-direction:column; gap:2px;
    }
    .menu .name{font-size:13px;color:#111}
    .menu .desc{font-size:12px;color:var(--muted)}
    .menu .hint{font-size:12px;color:#666}
    .menu .item:last-child{border-bottom:none}

    /* =========================
       Locked states
       ========================= */
    .locked .editable{pointer-events:none}
    .locked .plusbtn,.locked .handle{display:none}
    .locked .kicker .plus{display:none}
    .locked .avatar{pointer-events:none}
    .locked-note{
      font-size:12px;
      color:#111;
      border:1px solid var(--hair);
      border-radius:12px;
      padding:10px 12px;
      background:#fff;
      display:flex; justify-content:space-between; align-items:center; gap:10px;
    }
    .locked-note button{
      border:1px solid #111;
      background:#fff;
      border-radius:10px;
      padding:8px 10px;
      cursor:pointer;
      font-size:12px;
    }
    .locked-note button:hover{background:#f7f7f7}

    /* Alignment controls on block */
    .align-left{text-align:left}
    .align-center{text-align:center}
    .align-justify{text-align:justify}

    /* Tiny “BETA” for justify */
    .beta{
      font-size:10px;
      padding:2px 6px;
      border-radius:999px;
      border:1px solid var(--hair);
      color:#666;
      margin-left:6px;
      vertical-align:middle;
      user-select:none;
    }

    /* Archived style: tighter, more “printed” feel */
    .archived .title{font-weight:600}
    .archived .stage-in{padding-top:10px}
    .archived .hr{margin:12px 0}
    .archived .p{letter-spacing:.002em}
  </style>
</head>

<body>
  <!-- Topbar -->
  <div class="topbar">
    <div class="topbar-inner">
      <div class="brand" id="goHome" title="Home">
        <div class="dots" aria-hidden="true">
          <div class="dot"></div><div class="dot"></div><div class="dot"></div><div class="dot"></div>
        </div>
