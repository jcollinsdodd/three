  /* =========================
     Global shortcuts
     ========================= */
  window.addEventListener("keydown", (e) => {
    // New article
    if(e.key.toLowerCase() === "n" && !e.metaKey && !e.ctrlKey && viewLanding.classList.contains("active")){
      e.preventDefault(); createAndOpen(); return;
    }
    // Save
    if((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "s"){
      e.preventDefault();
      if(current){ saveCurrent("hotkey"); flash("Saved."); }
      return;
    }
    // Undo / redo
    if((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "z"){
      e.preventDefault();
      if(e.shiftKey){
        // redo
        const st = redoStack.pop();
        if(st){ undoStack.push(JSON.stringify(current)); restoreState(st); }
      } else {
        const st = undoStack.pop();
        if(st){ redoStack.push(JSON.stringify(current)); restoreState(st); }
      }
      return;
    }
  });

  /* =========================
     Avatar upload
     ========================= */
  avatarFile.addEventListener("change", async () => {
    const file = avatarFile.files && avatarFile.files[0];
    if(!file || !current) return;
    snapshotUndo();
    const data = await fileToDataUrl(file);
    current.avatarDataUrl = await downscaleToSquare(data, 40);
    queueAutosave(true);
    renderEditor();
    avatarFile.value = "";
  });

  /* =========================
     Image upload (block)
     ========================= */
  imgFile.addEventListener("change", async () => {
    const file = imgFile.files && imgFile.files[0];
    if(!file || !current || !currentBlockId) return;
    const b = current.blocks.find(x => x.id === currentBlockId);
    if(!b || b.type !== "image") return;

    snapshotUndo();
    const data = await fileToDataUrl(file);
    b.dataUrl = data;
    queueAutosave(true);
    renderEditor();
    imgFile.value = "";
    currentBlockId = null;
  });

  /* =========================
     Navigation
     ========================= */
  goHome.onclick = () => { show(viewLanding); };
  accountBtn.onclick = () => { show(viewArticles); renderList(); };
  newArticleBtn.onclick = () => createAndOpen();
  startWriting.onclick = () => createAndOpen();

  createFromList.onclick = () => createAndOpen();

  searchInput.addEventListener("input", renderList);

  exportAllBtn.onclick = () => {
    const blob = new Blob([JSON.stringify(loadAll(), null, 2)], {type:"application/json"});
    const a = document.createElement("a");
    a.href = URL.createObjectURL(blob);
    a.download = "writer-articles.json";
    a.click();
    URL.revokeObjectURL(a.href);
  };
  importAllBtn.onclick = () => importFile.click();
  importFile.onchange = async () => {
    const f = importFile.files && importFile.files[0];
    if(!f) return;
    try{
      const text = await f.text();
      const data = JSON.parse(text);
      if(!Array.isArray(data)) throw new Error("Not an array");
      saveAll(data);
      renderList();
      flash("Imported.");
    } catch(err){
      alert("Import failed.");
    }
    importFile.value = "";
  };

  /* =========================
     Helpers
     ========================= */
  function stripHTML(html){
    const d = document.createElement("div");
    d.innerHTML = html || "";
    return d.textContent || d.innerText || "";
  }
  function escapeHTML(s){
    return (s||"").replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":"&#39;"}[c]));
  }
  function escapeAttr(s){ return escapeHTML(s).replace(/"/g,"&quot;"); }

  function flash(text){
    const el = document.createElement("div");
    el.style.position="fixed";
    el.style.left="50%";
    el.style.top="16px";
    el.style.transform="translateX(-50%)";
    el.style.padding="10px 12px";
    el.style.border="1px solid var(--hair)";
    el.style.borderRadius="999px";
    el.style.background="#fff";
    el.style.boxShadow="var(--shadow)";
    el.style.zIndex="2000";
    el.style.fontSize="12px";
    el.style.letterSpacing=".08em";
    el.style.textTransform="uppercase";
    el.textContent = text;
    document.body.appendChild(el);
    setTimeout(() => el.remove(), 900);
  }

  function fileToDataUrl(file){
    return new Promise((res, rej) => {
      const r = new FileReader();
      r.onload = () => res(r.result);
      r.onerror = rej;
      r.readAsDataURL(file);
    });
  }

  async function downscaleToSquare(dataUrl, size){
    // downscale avatar to 40x40 (NYMag)
    const img = new Image();
    img.src = dataUrl;
    await img.decode();
    const c = document.createElement("canvas");
    c.width = size; c.height = size;
    const ctx = c.getContext("2d");
    const s = Math.min(img.width, img.height);
    const sx = (img.width - s)/2;
    const sy = (img.height - s)/2;
    ctx.drawImage(img, sx, sy, s, s, 0, 0, size, size);
    return c.toDataURL("image/jpeg", .9);
  }

  function getCaretRect(){
    const sel = window.getSelection();
    if(!sel || sel.rangeCount === 0) return null;
    const range = sel.getRangeAt(0).cloneRange();
    range.collapse(false);
    const rects = range.getClientRects();
    return rects && rects[0] ? rects[0] : null;
  }

  function RED_ARROW_SVG(w=17,h=11){
    // user-provided NYMag bullet arrow
    return `
      <svg viewBox="0 0 17 11" xmlns="http://www.w3.org/2000/svg" style="min-height:${h}px;min-width:${w}px;display:block;height:${h}px;width:${w}px;overflow:hidden">
        <path d="M2.317 5.5S.29 9.445.107 9.808C-.211 10.442.236 11 .72 11H5.6c.502 0 .811-.34 1.01-.732.184-.365 1.258-2.587 1.258-2.587h3.28v2.506c0 .716.781 1.009 1.24.535a955.072 955.072 0 0 0 4.349-4.524c.205-.216.263-.525.263-.698 0-.173-.058-.482-.263-.698a955.624 955.624 0 0 0-4.35-4.524c-.458-.474-1.24-.18-1.24.534V3.32H7.869S6.794 1.097 6.61.732C6.41.34 6.102 0 5.6 0H.719C.235 0-.211.558.108 1.192.29 1.555 2.317 5.5 2.317 5.5"
          fill="rgb(219,40,0)"></path>
      </svg>
    `;
  }

  function openArticleFromHash(){
    // optional: implement later if you want
  }

  /* =========================
     Initial boot
     ========================= */
  // If no articles, show landing; else landing anyway
  show(viewLanding);

  // In list view, render on entry
  accountBtn.addEventListener("click", () => {
    show(viewArticles);
    renderList();
  });

})();
</script>
